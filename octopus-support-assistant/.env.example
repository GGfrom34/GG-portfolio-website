# Required to run cli.py at all.
ANTHROPIC_API_KEY=sk-...

# Optional. If any of these four is missing, content-gap logging is silently
# disabled (handle_message still works -- it just never writes to Jira).
#
# JIRA_SITE_URL   e.g. https://guillaumegoujon.atlassian.net
# JIRA_EMAIL      the Atlassian account email the API token belongs to
# JIRA_API_TOKEN  create at https://id.atlassian.com/manage-profile/security/api-tokens
# JIRA_PROJECT_KEY  the shared project content-gap issues are created in (SCRUM)
# JIRA_SPRINT_ID    numeric id of the "Escalation - support agent" sprint on
#                   that project's board (currently 4 -- re-resolve if the
#                   sprint is ever deleted and recreated)
JIRA_SITE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SCRUM
JIRA_SPRINT_ID=4
